# Copy to .env and adjust:   cp .env.example .env
# docker-compose.yml builds DATABASE_URL / REDIS_URL / MEDIA_ROOT for the
# containers from these values; set them yourself only when running the
# backend outside Docker.

# --- PostgreSQL (used by the db container and to build DATABASE_URL) -------
POSTGRES_USER=pushtalk
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=pushtalk

# --- Security ----------------------------------------------------------------
# REQUIRED. At least 32 random characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- App -----------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Browser origins allowed to call the API directly (the nginx frontend is same-origin).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Host ports
FRONTEND_PORT=8080
API_PORT=8000

# --- Audio rules -----------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MIN_AUDIO_SECONDS=0.5
MAX_AUDIO_SECONDS=60
DURATION_TOLERANCE_SECONDS=0.5
WAVEFORM_PEAKS=64

# --- Processing / worker -----------------------------------------------------------
FFMPEG_TIMEOUT_SECONDS=30
ORDERING_WAIT_SECONDS=20
PROCESSING_STALE_SECONDS=120
WORKER_MAX_JOBS=4

# --- Realtime --------------------------------------------------------------------------
WS_AUTH_TIMEOUT_SECONDS=5
PRESENCE_TTL_SECONDS=45

# --- Only when running the backend OUTSIDE Docker (see README "Local development") ---
# DATABASE_URL=postgresql+asyncpg://pushtalk:change-me-local-db-password@localhost:5432/pushtalk
# REDIS_URL=redis://localhost:6379/0
# MEDIA_ROOT=./media
